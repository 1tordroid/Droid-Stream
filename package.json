    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-video": "6.19.2",
    "react-native-vlc-media-player": "1.0.98",
    "react-native-volume-manager": "^2.0.8",
    "react-native-webrtc": "155.0.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tldts": "^7.0.17",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-tvos/config-tv": "^0.1.7",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/eslint-config": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@react-native/typescript-config": "^0.88.1",
    "@types/base64-js": "^1.3.2",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.17.16",
    "@types/node": "^26.0.1",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "babel-jest": "30.5.2",
    "babel-preset-expo": "~58.0.24",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "patch-package": "^8.0.1",
    "prettier": "^3.0.0",
    "pretty-quick": "^4.1.1",
    "react-test-renderer": "19.3.0",
    "simple-git-hooks": "^2.12.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native": "npm:react-native-tvos@~0.88.1-0",
    "eslint-plugin-ft-flow": "3.0.11",
    "react-native-markdown-display": {
      "markdown-it": "^14.3.3"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native",
        "jest",
        "@types/jest",
        "react-native-bootsplash"
      ]
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
