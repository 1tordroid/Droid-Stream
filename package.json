{
  "name": "droid-stream",
  "version": "5.5.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "android": "npm run build:sandbox && expo run:android",
    "android:keystore": "node scripts/paste-keystore.js",
    "android:tv": "npm run build:sandbox && cross-env EXPO_TV=1 expo run:android",
    "ios": "npm run build:sandbox && expo run:ios",
    "lint": "eslint .",
    "start": "expo start",
    "build:playstore": "eas build --platform android --profile production --auto-submit",
    "build:playstore:tv": "eas build --platform android --profile production_tv --auto-submit",
    "build:sandbox": "node scripts/build-sandbox-runtime.mjs",
    "test": "jest",
    "pretest": "npm run build:sandbox",
    "prebuild": "npm run build:sandbox && expo prebuild",
    "prebuild:clean": "npm run build:sandbox && expo prebuild --clean",
    "prebuild:tv": "npm run build:sandbox && cross-env EXPO_TV=1 expo prebuild",
    "postinstall": "patch-package",
    "e2e": "maestro test .maestro",
    "e2e:phone": "maestro test --include-tags phone .maestro",
    "e2e:tv": "maestro test --include-tags tv .maestro"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "2.41.0",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@himanshu8443/react-native-apk-installer": "github:himanshu8443/react-native-apk-installer",
    "@notifee/react-native": "^9.1.8",
    "@preeternal/react-native-cookie-manager": "7.0.0",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.81.5",
    "axios": "^1.20.0",
    "base64-js": "^1.5.1",
    "buffer": "^6.0.3",
    "cheerio": "1.0.0-rc.12",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-brightness": "~58.0.2",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-intent-launcher": "~58.0.3",
    "expo-navigation-bar": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video-thumbnails": "~58.0.2",
    "nativewind": "^4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@~0.88.1-0",
    "react-native-bootsplash": "7.3.5",
    "react-native-css-interop": "^0.2.1",
    "react-native-drawer-layout": "4.2.12",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-fullscreen-chz": "^4.0.13",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-cast": "4.9.1",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-image-colors": "2.6.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv-storage": "13.0.1",
    "react-native-orientation-locker": "^1.7.0",
    "react-native-reanimated": "4.7.1",
